objectclass ( 1.2.840.113556.1.5.9 NAME 'user' SUP organizationalPerson STRUCTURAL
	MAY ( description $ objectSid $ objectGUID $ whenCreated $ whenChanged $ managedBy $ adminCount $ sAMAccountName $ userPrincipalName $ mail $ displayName $ givenName $ initials $ mobile $ company $ department $ manager $ directReports $ userAccountControl $ primaryGroupID $ sAMAccountType $ pwdLastSet $ lastLogon $ lastLogonTimestamp $ accountExpires $ badPwdCount $ logonCount $ lockoutTime $ servicePrincipalName $ thumbnailPhoto $ userPassword $ unicodePwd $ nTSecurityDescriptor $ msDS-ReplAttributeMetaData $ msDS-ReplValueMetaData $ msDS-ResultantPSO ) )

objectclass ( 1.2.840.113556.1.3.30 NAME 'computer' SUP user STRUCTURAL
	MAY ( operatingSystem $ dNSHostName ) )

objectclass ( 1.2.840.113556.1.5.8 NAME 'group' SUP top STRUCTURAL MUST groupType
	MAY ( cn $ member $ sAMAccountName $ sAMAccountType $ mail $ description $ objectSid $ objectGUID $ whenCreated $ whenChanged $ managedBy $ adminCount $ info $ nTSecurityDescriptor $ msDS-ReplAttributeMetaData $ msDS-ReplValueMetaData ) )

objectclass ( 1.2.840.113556.1.5.67 NAME 'domainDNS' SUP domain STRUCTURAL
	MAY ( gPLink $ maxPwdAge $ minPwdAge $ minPwdLength $ pwdHistoryLength $ pwdProperties $ lockoutThreshold $ lockoutDuration $ lockoutObservationWindow $ ms-DS-MachineAccountQuota $ fSMORoleOwner $ msDS-Behavior-Version $ description $ objectSid $ objectGUID $ whenCreated $ whenChanged $ managedBy $ adminCount ) )

objectclass ( 1.2.840.113556.1.5.157 NAME 'groupPolicyContainer' SUP container STRUCTURAL
	MAY ( displayName $ gPCFileSysPath $ versionNumber $ flags ) )

objectclass ( 1.2.840.113556.1.5.76 NAME 'foreignSecurityPrincipal' SUP top STRUCTURAL MUST objectSid
	MAY ( cn $ description $ objectSid $ objectGUID $ whenCreated $ whenChanged $ managedBy $ adminCount ) )

objectclass ( 1.3.6.1.4.1.99999.1.1 NAME 'adtestCommon' AUXILIARY
	MAY ( gPLink $ tombstoneLifetime $ fSMORoleOwner $ description $ objectSid $ objectGUID $ whenCreated $ whenChanged $ managedBy $ adminCount ) )

objectclass ( 1.3.6.1.4.1.99999.3.1 NAME 'configuration' SUP top STRUCTURAL
	MUST cn )

objectclass ( 1.3.6.1.4.1.99999.3.2 NAME 'crossRefContainer' SUP top STRUCTURAL
	MAY ( cn $ fSMORoleOwner $ msDS-EnabledFeature ) )

objectclass ( 1.3.6.1.4.1.99999.3.3 NAME 'crossRef' SUP top STRUCTURAL
	MUST cn MAY ( nCName $ nETBIOSName $ dnsRoot ) )

objectclass ( 1.3.6.1.4.1.99999.3.4 NAME 'site' SUP top STRUCTURAL
	MUST cn MAY description )

objectclass ( 1.3.6.1.4.1.99999.3.5 NAME 'serversContainer' SUP top STRUCTURAL
	MUST cn )

objectclass ( 1.3.6.1.4.1.99999.3.6 NAME 'server' SUP top STRUCTURAL
	MUST cn MAY description )

objectclass ( 1.3.6.1.4.1.99999.3.7 NAME 'nTDSDSA' SUP top STRUCTURAL
	MUST cn MAY options )

objectclass ( 1.3.6.1.4.1.99999.3.9 NAME 'rIDManager' SUP top STRUCTURAL
	MUST cn MAY fSMORoleOwner )

objectclass ( 1.3.6.1.4.1.99999.3.10 NAME 'infrastructureUpdate' SUP top STRUCTURAL
	MUST cn MAY fSMORoleOwner )

objectclass ( 1.3.6.1.4.1.99999.3.11 NAME 'msDS-OptionalFeature' SUP top STRUCTURAL
	MUST cn )

objectclass ( 1.3.6.1.4.1.99999.3.12 NAME 'msDS-PasswordSettingsContainer' SUP top STRUCTURAL
	MUST cn )

objectclass ( 1.3.6.1.4.1.99999.3.13 NAME 'msDS-PasswordSettings' SUP top STRUCTURAL
	MUST cn MAY ( description $ msDS-PasswordSettingsPrecedence $ msDS-MinimumPasswordLength $ msDS-PasswordHistoryLength $ msDS-PasswordComplexityEnabled $ msDS-PasswordReversibleEncryptionEnabled $ msDS-MaximumPasswordAge $ msDS-MinimumPasswordAge $ msDS-LockoutThreshold $ msDS-LockoutDuration $ msDS-LockoutObservationWindow $ msDS-PSOAppliesTo ) )

objectclass ( 1.3.6.1.4.1.99999.3.14 NAME 'trustedDomain' SUP top STRUCTURAL
	MUST cn MAY ( trustPartner $ flatName $ trustDirection $ trustType $ trustAttributes $ securityIdentifier ) )

objectclass ( 1.3.6.1.4.1.99999.3.100 NAME 'adtestAccountLock' AUXILIARY
	MAY nsAccountLock )
