# What TestDirectory/adtest.schema leaves to macOS's own slapd, which has these
# compiled in, for the OpenLDAP the demo directory runs. The same definitions
# as macOS's, except that OpenLDAP only allows its own operational attributes:
# memberOf and operatingSystemVersion are ordinary ones here, and the data is
# loaded without the schema check that would refuse them on entries whose
# classes do not list them. Loaded before adtest.schema.

attributetype ( 1.2.840.113556.1.4.364 NAME 'operatingSystemVersion'
	DESC 'Operating system version'
	EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.4.619 NAME 'dNSHostName'
	DESC 'DNS fully qualified domain name'
	EQUALITY caseExactMatch SUBSTR caseExactSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

attributetype ( 1.2.840.113556.1.2.102 NAME 'memberOf'
	DESC 'Group that the entry belongs to'
	EQUALITY distinguishedNameMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )

objectclass ( 1.2.840.113556.1.3.23 NAME 'container' STRUCTURAL MUST cn )
